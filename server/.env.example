# Copy to .env and fill in. Never commit .env.
PORT=5000

# Atlas → Connect → Drivers → connection string.
# Must include the DB name after the host (e.g. /jobscraper?).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jobscraper?retryWrites=true&w=majority

# Vite origin during local dev. Tighten this in production (phase 9).
CLIENT_ORIGIN=http://localhost:5173

# Documented public feed (JSON). Not LinkedIn/Indeed/Naukri.
SOURCE_URL=https://remoteok.com/api

# Linux/Render: Chromium refuses to start as root without this.
# Windows local: leave unset.
# PUPPETEER_NO_SANDBOX=1

# Pause before goto (ms). One GET today; same knobs would pace paginated pages.
# SCRAPE_DELAY_MIN_MS=800
# SCRAPE_DELAY_MAX_MS=2500

# Optional stub. Empty = no proxy (local scrape uses your IP). Comma-separated.
# Round-robin is in-process. Paid residential + sticky session is the hostile-target upgrade — not this list.
# PROXY_URLS=http://127.0.0.1:8888,http://127.0.0.1:8889

# Retries cover launch/goto/5xx/429 only (not 403, not bad JSON, not empty
# payload — see design-doc.md). 2 retries = 3 attempts total, full-jitter backoff.
# SCRAPE_MAX_RETRIES=2
# SCRAPE_RETRY_BASE_MS=1000
# SCRAPE_RETRY_MAX_MS=8000

# Circuit breaker: N consecutive failed attempts (circuit_open skips do not
# count) pauses new runs until the cooldown elapses. 0 disables the breaker.
# Shrink the cooldown locally if you want to demo it tripping and closing.
# CIRCUIT_BREAKER_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_MS=300000

# Standard 5-field cron syntax. Default: every 6 hours. Render's free tier
# suspends the process on inactivity, so this only fires while something is
# keeping the server awake — not a real always-on cron.
# SCRAPE_CRON_SCHEDULE=0 */6 * * *

# Set to "false" to turn the automatic scheduler off (manual npm run scrape
# / later the HTTP trigger still work). Anything else, including unset, is on.
# SCRAPE_SCHEDULER_ENABLED=true
