# Copy to .env and fill in. Never commit .env.
PORT=5000

# Atlas → Connect → Drivers → connection string.
# Must include the DB name after the host (e.g. /jobscraper?).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jobscraper?retryWrites=true&w=majority

# Vite origin during local dev. Tighten this in production (phase 9).
CLIENT_ORIGIN=http://localhost:5173

# Documented public feed (JSON). Not LinkedIn/Indeed/Naukri.
SOURCE_URL=https://remoteok.com/api

# Linux/Render: Chromium refuses to start as root without this.
# Windows local: leave unset.
# PUPPETEER_NO_SANDBOX=1

# Pause before goto (ms). One GET today; same knobs would pace paginated pages.
# SCRAPE_DELAY_MIN_MS=800
# SCRAPE_DELAY_MAX_MS=2500

# Optional stub. Empty = no proxy (local scrape uses your IP). Comma-separated.
# Round-robin is in-process. Paid residential + sticky session is the hostile-target upgrade — not this list.
# PROXY_URLS=http://127.0.0.1:8888,http://127.0.0.1:8889
